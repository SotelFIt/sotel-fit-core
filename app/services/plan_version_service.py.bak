from sqlalchemy.orm import Session
from models.plan_version import PlanVersion

def create_plan_version(
    db: Session,
    client_id: int,
    plan_id: int,
    version_number: int,
    training_plan: str,
    diet_plan: str,
    notes: str,
    change_reason: str
):
    version = PlanVersion(
        client_id=client_id,
        plan_id=plan_id,
        version_number=version_number,
        training_plan=training_plan,
        diet_plan=diet_plan,
        notes=notes,
        change_reason=change_reason
    )
    db.add(version)
    db.commit()
    db.refresh(version)
    return version

def get_plan_versions_by_client(db: Session, client_id: int):
    return db.query(PlanVersion).filter(PlanVersion.client_id == client_id).all()